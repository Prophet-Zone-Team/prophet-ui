{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.mjs",
  "name": "prophet-ui-dev",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "THE_ODDS_API_WORLD_CUP_SPORT_KEY": "soccer_fifa_world_cup_winner",
    "THE_ODDS_API_REGIONS": "us,uk,eu",
    "ENABLE_REAL_POLYMARKET_ORDERS": "false"
  },
  "d1_databases": [
    {
      "binding": "MARKET_HISTORY_DB",
      "database_name": "world-cup-market-history",
      "database_id": "674ada08-ce93-4076-ac06-4b61d1d2b4bf"
    }
  ],
  "routes": [
    {
      "pattern": "dev.prophet.zone",
      "zone_name": "prophet.zone",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  }
}
