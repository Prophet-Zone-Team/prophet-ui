{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": "worker.mjs",
  "name": "prophet-ui-pre",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "alias": {
    "server-only": "./scripts/server-only-stub.mjs"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
