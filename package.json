{
  "name": "world-cup-prediction-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=8192' next dev",
    "dev:turbo": "NODE_OPTIONS='--max-old-space-size=8192' next dev --turbo",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "cf:build": "NODE_OPTIONS='--max-old-space-size=6144' opennextjs-cloudflare build",
    "lint": "eslint . --quiet",
    "lint:strict": "eslint . --max-warnings=0",
    "check:trading-safety": "node scripts/check-trading-safety.mjs",
    "smoke:trading:prod": "node scripts/smoke-trading-production.mjs",
    "start": "next start",
    "preview": "node scripts/stop-preview-ports.mjs && NODE_OPTIONS='--max-old-space-size=6144' opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NODE_OPTIONS='--max-old-space-size=6144' opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@defuse-protocol/contract-types": "^0.6.4",
    "@defuse-protocol/intents-sdk": "^0.68.0",
    "@defuse-protocol/internal-utils": "^0.35.0",
    "@defuse-protocol/one-click-sdk-typescript": "^0.1.24",
    "@lucide/lab": "^0.1.2",
    "@noble/hashes": "^2.2.0",
    "@polymarket/builder-abstract-signer": "^0.0.1",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/builder-signing-sdk": "^0.0.8",
    "@polymarket/clob-client-v2": "^1.0.6",
    "@privy-io/react-auth": "^3.28.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@resvg/resvg-wasm": "^2.6.2",
    "@scure/base": "^2.2.0",
    "@stableflow/core": "rc",
    "@tanstack/react-query": "^5.100.14",
    "axios": "^1.16.1",
    "big.js": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.0.0",
    "html-to-image": "^1.11.13",
    "jose": "^6.2.3",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-intl": "^4.13.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "satori": "^0.26.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.1",
    "undici": "^8.3.0",
    "viem": "^2.48.11",
    "wagmi": "^2.19.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "@types/big.js": "^7.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.68.0"
  },
  "pnpm": {
    "overrides": {
      "qr": "~0.5.5"
    }
  }
}
