{
  "name": "world-cup-prediction-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "node scripts/stop-preview-ports.mjs && npm run d1:schema:local && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "collect:market": "node scripts/collect-market-snapshots.mjs",
    "collect:market:local": "node scripts/collect-market-snapshots.mjs http://localhost:3005 all",
    "collect:signals:local": "curl -X POST http://localhost:3000/api/signals/collect?source=all",
    "d1:schema:local": "npx wrangler d1 execute world-cup-market-history --local --file=db/d1/schema.sql",
    "d1:schema:remote": "npx wrangler d1 execute world-cup-market-history --remote --file=db/d1/schema.sql"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "^1.0.6",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.8.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.68.0"
  }
}
