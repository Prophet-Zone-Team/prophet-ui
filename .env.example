# Prophet backend (staging default: https://api_stg.prophet.zone)
# NEXT_PUBLIC_PROPHET_API_URL=https://api_stg.prophet.zone

# WalletConnect project id (used by Privy external wallet connectors / mobile deep links)
# NEXT_PUBLIC_RAINBOWKIT_PROJECT_ID=
# Public app URL used for WalletConnect metadata during SSR (must match deployed origin)
# NEXT_PUBLIC_APP_URL=https://dev.prophet.zone

# Comma-separated CORS origins for cross-project /api access.
# Supports exact origins and https://*.domain wildcard subdomains.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.rhea.finance,https://*.ref-finance.com

# Privy (email OTP / Google OAuth / external wallet auth)
# NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Local only: force any game trade page into live UI with mock prices (initial snapshot only, no auto-tick).
# NEXT_PUBLIC_USE_MOCK_LIVE_FIXTURE=true

# Local only: enqueue one mock Prophet WS notification per notice_type on load (5s each in queue).
# NEXT_PUBLIC_MOCK_PROPHET_NOTIFICATIONS=true

# Local only: generate Twitter share-card meta on /trade/game when twitterPreview=1 is present.
# Example: http://localhost:3000/trade/game?slug=<slug>&twitterPreview=1

# Local only: skip strategy bid pre-validation (min order size, balance checks) to test signing/submit flow.
# NEXT_PUBLIC_STRATEGY_BID_SKIP_PRE_VALIDATION=true

# Fallback to data/matches.json when live Polymarket football events fail or return empty.
# Set to false/0/off to disable once live data is stable.
FOOTBALL_MATCHES_FILE_FALLBACK=true

# Zetta smart wallet analytics API (default: https://zetta.prophet.zone)
# ZETTA_API_URL=https://zetta.prophet.zone
# NEXT_PUBLIC_ZETTA_API_URL=https://zetta.prophet.zone
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=
THE_ODDS_API_WORLD_CUP_SPORT_KEY=soccer_fifa_world_cup_winner
THE_ODDS_API_REGIONS=us,uk,eu
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
# The Next.js server must be able to reach POLYMARKET_CLOB_HOST for CLOB credential derivation and trading APIs.
# Development only: route server-side Polymarket requests through a local proxy/VPN.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
# Optional fallback IP geolocation lookup when edge geo headers are missing.
# GEOIP_LOOKUP_URL=https://ipwho.is/{ip}
# ELIGIBILITY_FORCE_ELIGIBLE=true
POLYMARKET_BRIDGE_URL=https://bridge.polymarket.com
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=3
POLYMARKET_BUILDER_CODE=
POLYMARKET_RELAYER_URL=https://relayer-v2.polymarket.com
STABLEFLOW_JWT_TOKEN=
RELAYER_API_KEY=
RELAYER_API_KEY_ADDRESS=
# Required for app-managed deposit wallet deployment/approval when users are not the RELAYER_API_KEY_ADDRESS.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=
TRADING_SESSION_SECRET=
MARKET_COLLECTOR_SECRET=

# --- NEAR Confidential Intents (Private Mode) ---
ONE_CLICK_API_KEY=
# IntentsSDK environment used to build the auth verification message: "production" | "stage".
NEAR_INTENTS_ENV=production
# Optional JWT signature verification. Leave BOTH empty to skip signature
# verification and rely on identity matching (access token account_id/sub must
# equal the locally derived intentsUserId). Provide a JWKS JSON (public key set)
# and the matching issuer to enable full jose signature verification.
ONE_CLICK_JWT_PUBLIC_KEY=
ONE_CLICK_JWT_ISSUER=
# Optional dedicated secret for the cross-subdomain Confidential session cookie.
# Falls back to TRADING_SESSION_SECRET when unset. The cookie domain is derived
# from the MAIN_DOMAIN constant in src/config/funding (".prophet.zone").
CONFIDENTIAL_SESSION_SECRET=
